+v116_phase PLACE_DESIGN
 place_design -directive $place_directive
-v115_reports place
+v116_reports place
 if {$phys_directive ne "NONE"} {
-    v115_phase PRE_ROUTE_PHYS_OPT
+    v116_phase PRE_ROUTE_PHYS_OPT
     phys_opt_design -directive $phys_directive
