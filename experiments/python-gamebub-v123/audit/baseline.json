  "V123_candidate_experiment_proposal": {
    "acceptance_rule": "Claim overlap/savings only if exact output/error/debt equivalence holds and paired traces show an actual end-to-end edge delta plus directly observed validation-active overlap with useful work. Otherwise report no measured benefit.",
    "causal_controls": [
      "same harness/toolchain and initial state",
      "same exact input records and deterministic service/ACK trace",
      "paired every-edge input acceptance, error, write debt and output digest checks",
      "repeated independent trace pairs after the first exact pair"
    ],
    "intervention": "Paired V122 baseline and V123 rank candidate with only the rank/previous-position predicate changed; hold queue, controller/service, and parent policy fixed.",
    "limits": "V122 aggregate stall/service vectors do not reveal per-edge validation occupancy or causal savings. Do not expand them into synthetic event cycles or claim saved cycles.",
    "measurement": "Cycle-accurate actual scratch/parent runs on identical retained coefficient inputs and a deterministic external request/ACK schedule; capture each offered/accepted tuple and full32 predecessor, predicate result, phase/raw context, first fault, ready/state, write accept/ACK, bank/epoch, output/canonical hashes, and frame-start to validated-publication cycle.",
    "question": "Does one-cycle-ahead sparse-order validation overlap existing scratch work without delaying coefficient acceptance, changing fault priority, or extending validated publication?",
    "required_data_before_claim": [
      "frozen V122/V123 source maps and hashes",
      "complete edge trace from frame start through validated publication",
      "coefficient block/index/value, band/phase, raw flag, previous_valid and full32 previous_position at each input",
      "predicate operands/result and acceptance/error signals each edge",
      "write request and matched ACK tuple with bank/epoch/token/bytes",
      "canonical/reference/output digests and publication fence",
      "trace collector/parser hashes and complete attempt receipts"
    ]
  },
