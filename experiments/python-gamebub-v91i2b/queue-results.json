    "case_count": 11
  },
  "protocol": {
    "mode0": "frozen REQ/WAIT/SEND byte service",
    "mode1_fifo_slots": 2,
    "mode1_registered_pending_slots": 1,
    "mode1_total_owners_bound": 2,
    "response_latency_edges": 1,
    "bypass": false,
    "issue_rule": "issued < chunk_length and count + pending - pop < 2",
    "pop_rule": "count > 0 and child_ready",
    "push_rule": "old pending response, after address and epoch verification"
  },
