// Rasterized at build time: no per-patch objects or nested ramp layouts.
export component GammaPreview inherits Rectangle {
    preferred-height: 88px;
    min-height: 88px;
    max-height: 88px;
    background: black;
    Text {
        x: 2px; y: 1px; height: 12px;
        text: "Gray / Shadows + Highlights / RGB";
        color: white; font-size: 10px;
    }
    Image {
        x: 2px; y: 14px;
        width: parent.width - 4px; height: 60px;
        source: @image-url("gamma_pattern.svg");
        image-fit: fill;
    }
    Text {
        x: 2px; y: 75px; height: 12px;
        text: "Keep brightness fixed to compare";
        color: white; font-size: 10px;
    }
}
