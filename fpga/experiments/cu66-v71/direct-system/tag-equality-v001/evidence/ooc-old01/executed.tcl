set_param general.maxThreads 2
set out [file normalize [lindex $argv 0]]
set root [file join $out inputs]
create_project -in_memory -part xc7a100tcsg324-1 tag_base
set_property include_dirs [list [file join $root fpga/experiments/cu66-v70/memory] [file join $root fpga/experiments/cu66-v69/packet] [file join $root fpga/experiments/cu66-v69/inverse]] [current_fileset]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-system/syncsafe-math-v002/cu71_system_direct_syncsafe.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-system/board-math-v001/cu71_receiver_direct_math.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-system/grouped-v001/source/cu71_tile_memory_direct.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-system/grouped-v001/source/cu71_word_bridge_direct.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-system/grouped-v001/source/cu71_memory_system_direct.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-system/grouped-v001/source/moonshine_sdram_burst.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v69/packet/cu66_packet_control.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v69/banks/cu66_frame_bank_control.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-system/validpipe-v003/cu71_base_pipeline_math.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v69/inverse/cu66_expand_tiles.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/inverse-reset/cu71_dequant_resetlight.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/inverse-validpipe/cu71_idct_validpipe.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/inverse-reset/cu71_reconstruct_resetlight.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/entropy/cu71_ab38_decoder_arithpipe_v4.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/rows/cu71_tile_rows.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/codec/math-v004/cu71_rows_sha256_fast.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/hash/cu71_sha256_bytes_lookahead.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-system/cu71_direct_prepare_adapter.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-display/cdc/cu71_direct_scanout_syncsafe.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-display/cu71_cache_dma.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-display/cu71_direct_cache.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-display/cu71_yuv_pixel_pipe.sv]
read_verilog -sv [file join $root fpga/experiments/cu66-v71/direct-display/cdc/cu71_lcd_lines_syncsafe.sv]

synth_design -top cu71_base_pipeline_math -mode out_of_context -part xc7a100tcsg324-1 -flatten_hierarchy none
create_clock -period 10.0 -name core [get_ports clk]
set_input_delay -clock core -max 1.0 [get_ports -filter {DIRECTION == IN && NAME != clk}]
set_input_delay -clock core -min 0.0 [get_ports -filter {DIRECTION == IN && NAME != clk}]
set_output_delay -clock core -max 1.0 [get_ports -filter {DIRECTION == OUT}]
set_output_delay -clock core -min 0.0 [get_ports -filter {DIRECTION == OUT}]
set digest_regs [get_cells -quiet -hier -regexp {^canonical/sha/hash_state_reg\[[0-7]\]\[[0-9]+\]$}]
set work_regs [get_cells -quiet -hier -regexp {^canonical/sha/[a-h]_reg\[[0-9]+\]$}]
if {[llength $digest_regs]!=256 || [llength $work_regs]!=256} {error "Exact actual SHA source/destination FF count differs"}
set digest_C [get_pins -of_objects $digest_regs -filter {REF_PIN_NAME == C}]
set work_CE [get_pins -of_objects $work_regs -filter {REF_PIN_NAME == CE}]
if {[llength $digest_C]!=256 || [llength $work_CE]!=256} {error "SHA timing endpoint roles differ"}
report_timing -from $digest_C -to $work_CE -max_paths 40 -file [file join $out digest-to-working-CE.rpt]
set f [open [file join $out target-counts.txt] w];puts $f "DIGEST_C=[llength $digest_C] WORKING_CE=[llength $work_CE]";close $f
report_timing_summary -delay_type min_max -report_unconstrained -file [file join $out timing.rpt]
report_timing -delay_type max -max_paths 40 -file [file join $out setup-paths.rpt]
report_timing -delay_type min -max_paths 30 -file [file join $out hold-paths.rpt]
report_utilization -hierarchical -file [file join $out utilization.rpt]
report_exceptions -coverage -file [file join $out exceptions.rpt]
write_checkpoint -force [file join $out synthesized.dcp]
puts TAG_BASE_OOC_COMPLETE_UNPLACED_NOT_BOARD_SIGNOFF
