# GameBub Rev4/Rev4.1 native LCD diagnostic constraints.
set_property BITSTREAM.CONFIG.USERID 0xB0100004 [current_design]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]

set_property -dict { PACKAGE_PIN P17 IOSTANDARD LVCMOS33 } [get_ports clk_50mhz]
create_clock -name clk_50mhz -period 20.000 [get_ports clk_50mhz]

set_property -dict { PACKAGE_PIN T18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports lcd_dotclk]
set_property -dict { PACKAGE_PIN U18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports lcd_hsync]
set_property -dict { PACKAGE_PIN T16 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports lcd_vsync]
set_property -dict { PACKAGE_PIN R18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports lcd_data_en]

set_property -dict { PACKAGE_PIN E18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_r[0]}]
set_property -dict { PACKAGE_PIN E16 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_r[1]}]
set_property -dict { PACKAGE_PIN D18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_r[2]}]
set_property -dict { PACKAGE_PIN D17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_r[3]}]
set_property -dict { PACKAGE_PIN C17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_r[4]}]
set_property -dict { PACKAGE_PIN B18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_r[5]}]
set_property -dict { PACKAGE_PIN B17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_r[6]}]
set_property -dict { PACKAGE_PIN A18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_r[7]}]

set_property -dict { PACKAGE_PIN J17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_g[0]}]
set_property -dict { PACKAGE_PIN J18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_g[1]}]
set_property -dict { PACKAGE_PIN H16 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_g[2]}]
set_property -dict { PACKAGE_PIN H17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_g[3]}]
set_property -dict { PACKAGE_PIN G18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_g[4]}]
set_property -dict { PACKAGE_PIN G17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_g[5]}]
set_property -dict { PACKAGE_PIN F18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_g[6]}]
set_property -dict { PACKAGE_PIN E17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_g[7]}]

set_property -dict { PACKAGE_PIN R17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_b[0]}]
set_property -dict { PACKAGE_PIN P18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_b[1]}]
set_property -dict { PACKAGE_PIN N17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_b[2]}]
set_property -dict { PACKAGE_PIN M17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_b[3]}]
set_property -dict { PACKAGE_PIN M18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_b[4]}]
set_property -dict { PACKAGE_PIN L16 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_b[5]}]
set_property -dict { PACKAGE_PIN L18 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_b[6]}]
set_property -dict { PACKAGE_PIN K17 IOSTANDARD LVCMOS33 SLEW FAST DRIVE 8 } [get_ports {lcd_data_b[7]}]
