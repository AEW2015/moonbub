`verilator_config
// Official UNISIM TDP model drives unused ECC/status outputs using both
// assign/deassign and sequential assignments. Ports are unconnected by the
// exact V027 RAMB18 instances. Limit the diagnostic suppression to this vendor
// source; do not disable decoder, memory-model or harness assertions.
lint_off -rule BLKANDNBLK -file "*RAMB18E1.v"
